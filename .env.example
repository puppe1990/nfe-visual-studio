# Turso / libSQL — use file: for local dev, libsql:// for cloud
TURSO_DATABASE_URL=file:local-nfe.db
TURSO_AUTH_TOKEN=

# SEFAZ direto (sem provedor intermediário)
# simulated = não chama rede (default)
# real = SOAP + mTLS + assinatura A1 nos endpoints oficiais
SEFAZ_MODE=simulated
# UF do emitente para escolher endpoint (SP, SC, RJ, …)
SEFAZ_UF=SP

